{
  "compilerOptions": {
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "baseUrl": "..",
    "paths": {
      "@common": [
        "common/commonTypes.ts"
      ],
      "@components": [
        "client/src/components/index.ts"
      ],
      "@context": [
        "client/src/context/index.ts"
      ],
      "@hooks": [
        "client/src/hooks/index.ts"
      ],
      "@screens": [
        "client/src/screens/index.ts"
      ]
    }
  },
  "include": [
    "./src/**/*",
    "../common/commonTypes.ts"
  ],
  "extends": "expo/tsconfig.base"
}